#!/bin/bash
# Project: Crankshaft
# Copy the Crankshaft logs to the SD card's boot partition (FAT, readable on
# any PC) so they can be read without a network connection to the Pi.
# Started by crankshaft-core (Settings > Car > Save logs) via
# crankshaft-save-logs.service; the result goes to /run/crankshaft.
set -u
RESULT=/run/crankshaft/save-logs.result

finish() {
    if [ -d /run/crankshaft ]; then
        echo "$1" > "$RESULT"
        chmod 0644 "$RESULT"
    fi
}

BOOT=/boot/firmware
if ! mountpoint -q "$BOOT"; then
    BOOT=/boot
fi
if ! mountpoint -q "$BOOT"; then
    finish "error boot partition not mounted"
    exit 1
fi
# The boot partition may be mounted read-only.
REMOUNTED=0
if ! touch "$BOOT/.crankshaft-write-test" 2>/dev/null; then
    mount -o remount,rw "$BOOT" && REMOUNTED=1
fi
rm -f "$BOOT/.crankshaft-write-test"

STAMP=$(date +%Y%m%d-%H%M%S)
DIR="$BOOT/crankshaft-logs/$STAMP"
if ! mkdir -p "$DIR"; then
    finish "error cannot write to the SD card boot partition"
    exit 1
fi

LINES=60000
journalctl -b -u crankshaft-core --no-pager -o short-precise -n "$LINES" > "$DIR/core.txt" 2>&1
journalctl -b -u crankshaft-ui-slim -u crankshaft-ui-slim-display-setup --no-pager -o short-precise -n "$LINES" > "$DIR/ui.txt" 2>&1
journalctl -b -p warning --no-pager -o short-precise -n 5000 > "$DIR/system-warnings.txt" 2>&1
# Wi-Fi hotspot and the Wi-Fi chip's kernel messages (driver resets show here).
journalctl -b -u crankshaft-aa-hotspot -u bluetooth --no-pager -o short-precise -n 5000 > "$DIR/wifi-bt.txt" 2>&1
journalctl -b -k --no-pager -o short-precise 2>/dev/null | grep -E 'brcmf|mmc[0-9]|ieee80211|wlan0' | tail -n 2000 > "$DIR/wifi-kernel.txt"
# The boot before this one too: after a hang the only way out is a restart,
# and then that boot is the interesting one.
if journalctl -b -1 -n 1 --no-pager >/dev/null 2>&1; then
    journalctl -b -1 -u crankshaft-core --no-pager -o short-precise -n "$LINES" > "$DIR/previous-boot-core.txt" 2>&1
    journalctl -b -1 -u crankshaft-ui-slim -u crankshaft-ui-slim-display-setup --no-pager -o short-precise -n "$LINES" > "$DIR/previous-boot-ui.txt" 2>&1
    journalctl -b -1 -p warning --no-pager -o short-precise -n 5000 > "$DIR/previous-boot-warnings.txt" 2>&1
fi
{
    date; uptime; echo
    vcgencmd get_throttled 2>&1; vcgencmd measure_temp 2>&1; echo
    free -m; echo
    df -h; echo
    top -bn1 | head -30; echo
    lsusb 2>&1; echo
    ip addr 2>&1
} > "$DIR/system.txt" 2>&1
{
    systemd-analyze 2>&1; echo
    systemd-analyze critical-chain crankshaft-core.service 2>&1; echo
    systemd-analyze critical-chain crankshaft-ui-slim.service 2>&1; echo
    systemd-analyze blame 2>&1 | head -40
} > "$DIR/boot-time.txt" 2>&1
# Crash backtraces (systemd-coredump). Only written when something crashed.
if command -v coredumpctl >/dev/null 2>&1 && coredumpctl list --no-pager >/dev/null 2>&1; then
    {
        coredumpctl list --no-pager 2>&1; echo
        for exe in /usr/bin/crankshaft-ui-slim /usr/bin/crankshaft-core; do
            coredumpctl info --no-pager "$exe" 2>&1 | head -400; echo
        done
    } > "$DIR/crashes.txt" 2>&1
fi
for f in /var/log/crankshaft/*.log; do
    [ -f "$f" ] && tail -c 4000000 "$f" > "$DIR/$(basename "$f")"
done

# Keep the five newest sets so the partition doesn't fill up.
ls -1dt "$BOOT"/crankshaft-logs/*/ 2>/dev/null | tail -n +6 | xargs -r rm -rf
sync
[ "$REMOUNTED" = 1 ] && mount -o remount,ro "$BOOT"
finish "ok crankshaft-logs/$STAMP"
