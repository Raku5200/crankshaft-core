// Project: Crankshaft
// Let crankshaft-core (system user, no login session) start, stop and
// restart the wireless Android Auto hotspot unit.
polkit.addRule(function(action, subject) {
    if (subject.user === "crankshaft" &&
        action.id === "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") === "crankshaft-aa-hotspot.service") {
        return polkit.Result.YES;
    }
});
