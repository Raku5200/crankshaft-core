#!/bin/sh
# Project: Crankshaft
# Wi-Fi access point for wireless Android Auto, run by crankshaft-aa-hotspot.service.
#
# NetworkManager's hotspot always offers WPA-PSK-SHA256 next to WPA-PSK when
# wpa_supplicant supports PMF. The Pi's brcmfmac (BCM43430) can't complete
# that handshake, so phones fail with "possible PSK mismatch". hostapd lets us
# offer plain WPA2-PSK (CCMP) only. crankshaft-core writes the SSID/password to
# /run/crankshaft/aa-hotspot.env and restarts this service.
set -eu

IFACE=wlan0
ADDR=10.42.0.1
ENV_FILE=/run/crankshaft/aa-hotspot.env
RUN_DIR=/run/crankshaft-aa-hotspot

value() {
    sed -n "s/^$1=//p" "$ENV_FILE" | head -n1
}

wait_iface() {
    i=0
    while [ ! -e "/sys/class/net/$IFACE" ] && [ "$i" -lt 60 ]; do
        sleep 0.25
        i=$((i + 1))
    done
}

# The Pi Zero 2 W's Wi-Fi chip sometimes stops answering. Either its firmware
# crashes (kernel: "brcmf_fw_crashed") or the SDIO bus to it stalls (kernel:
# "mmc1: Timeout waiting for hardware interrupt", "brcmf_sdio_rxfail: count
# never zeroed") without a crash message. Both leave the hotspot dead, so
# phones can't rejoin until the driver is reloaded.

# The SDIO host the Wi-Fi chip hangs off (mmc1 on the Pi Zero 2 W).
wifi_mmc_host() {
    readlink -f "/sys/class/net/$IFACE/device" 2>/dev/null |
        sed -n 's#.*/\(mmc[0-9][0-9]*\):[^/]*$#\1#p'
}

# A score that only goes up while the chip is failing: a firmware crash or a
# stuck bus counts 2, a single SDIO timeout 1 (one on its own can recover).
wifi_fault_score() {
    log=$(dmesg 2>/dev/null || true)
    crash=$(printf '%s\n' "$log" | grep -c -e 'brcmf_fw_crashed' -e 'count never zeroed' || true)
    tmo=0
    if [ -n "$MMC_HOST" ]; then
        tmo=$(printf '%s\n' "$log" | grep -c "$MMC_HOST: Timeout waiting for hardware interrupt" || true)
    fi
    echo $((crash * 2 + tmo))
}

reload_wifi() {
    echo "crankshaft-aa-hotspot: Wi-Fi chip stopped answering; reloading the driver" >&2
    for m in brcmfmac_cyw brcmfmac_wcc brcmfmac_bca brcmfmac; do
        timeout 15 modprobe -r "$m" 2>/dev/null || true
    done
    # Reset the SDIO host too, so a stuck bus starts clean.
    if [ -n "$HOST_DEV" ] && [ -n "$HOST_DRV" ]; then
        echo "$HOST_DEV" > "$HOST_DRV/unbind" 2>/dev/null || true
        sleep 1
        echo "$HOST_DEV" > "$HOST_DRV/bind" 2>/dev/null || true
    fi
    sleep 1
    timeout 20 modprobe brcmfmac || true
    wait_iface
    if [ -e "/sys/class/net/$IFACE" ]; then
        echo "crankshaft-aa-hotspot: $IFACE is back" >&2
    else
        echo "crankshaft-aa-hotspot: $IFACE did not come back" >&2
    fi
}

case "${1:-start}" in
start)
    if [ ! -r "$ENV_FILE" ]; then
        echo "crankshaft-aa-hotspot: $ENV_FILE missing" >&2
        exit 1
    fi
    SSID=$(value SSID)
    PSK=$(value PSK)
    CHANNEL=$(value CHANNEL)
    if [ -z "$SSID" ]; then
        echo "crankshaft-aa-hotspot: no SSID" >&2
        exit 1
    fi
    case "$CHANNEL" in
        ''|0) CHANNEL=6 ;;
    esac

    mkdir -p "$RUN_DIR"
    chmod 700 "$RUN_DIR"

    # Left over from older images; NetworkManager fails to load it.
    rm -f /etc/NetworkManager/system-connections/Crankshaft-WirelessAA-Hotspot.nmconnection

    if command -v nmcli >/dev/null 2>&1; then
        nmcli device set "$IFACE" managed no 2>/dev/null || true
    fi
    rfkill unblock wifi 2>/dev/null || true
    wait_iface
    ip addr flush dev "$IFACE" || true
    ip link set "$IFACE" up
    ip addr add "$ADDR/24" dev "$IFACE"

    {
        echo "interface=$IFACE"
        echo "driver=nl80211"
        echo "ssid=$SSID"
        echo "hw_mode=g"
        echo "channel=$CHANNEL"
        echo "ieee80211n=1"
        echo "wmm_enabled=1"
        echo "auth_algs=1"
        if [ -n "$PSK" ]; then
            echo "wpa=2"
            echo "wpa_key_mgmt=WPA-PSK"
            echo "rsn_pairwise=CCMP"
            echo "wpa_passphrase=$PSK"
        fi
    } > "$RUN_DIR/hostapd.conf"
    chmod 600 "$RUN_DIR/hostapd.conf"

    # DHCP only (port=0: no DNS). The phone gets 10.42.0.x; the Pi is 10.42.0.1.
    if [ -f "$RUN_DIR/dnsmasq.pid" ]; then
        kill "$(cat "$RUN_DIR/dnsmasq.pid")" 2>/dev/null || true
    fi
    dnsmasq --conf-file=/dev/null \
        --interface="$IFACE" --bind-interfaces --except-interface=lo \
        --port=0 \
        --dhcp-range=10.42.0.10,10.42.0.254,255.255.255.0,1h \
        --dhcp-authoritative \
        --dhcp-leasefile="$RUN_DIR/dnsmasq.leases" \
        --pid-file="$RUN_DIR/dnsmasq.pid"

    MMC_HOST=$(wifi_mmc_host)
    HOST_DEV=""
    HOST_DRV=""
    if [ -n "$MMC_HOST" ] && [ -e "/sys/class/mmc_host/$MMC_HOST/device/driver" ]; then
        HOST_DEV=$(basename "$(readlink -f "/sys/class/mmc_host/$MMC_HOST/device")")
        HOST_DRV=$(readlink -f "/sys/class/mmc_host/$MMC_HOST/device/driver")
    fi

    hostapd "$RUN_DIR/hostapd.conf" &
    HPID=$!
    trap 'kill "$HPID" 2>/dev/null || true; wait "$HPID" 2>/dev/null || true; exit 0' TERM INT
    base=$(wifi_fault_score)
    while kill -0 "$HPID" 2>/dev/null; do
        sleep 2
        now=$(wifi_fault_score)
        if [ "$now" -ge $((base + 2)) ]; then
            kill "$HPID" 2>/dev/null || true
            wait "$HPID" 2>/dev/null || true
            reload_wifi
            # Non-zero so systemd restarts the hotspot (RestartSec=3).
            exit 1
        fi
    done
    rc=0
    wait "$HPID" || rc=$?
    exit "$rc"
    ;;
stop)
    if [ -f "$RUN_DIR/dnsmasq.pid" ]; then
        kill "$(cat "$RUN_DIR/dnsmasq.pid")" 2>/dev/null || true
        rm -f "$RUN_DIR/dnsmasq.pid"
    fi
    ip addr flush dev "$IFACE" 2>/dev/null || true
    if command -v nmcli >/dev/null 2>&1; then
        nmcli device set "$IFACE" managed yes 2>/dev/null || true
    fi
    ;;
*)
    echo "usage: $0 start|stop" >&2
    exit 2
    ;;
esac
